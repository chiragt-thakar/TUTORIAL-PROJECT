# Optional. Only needed for cross-device progress sync — see the
# "Optional cross-device sync (Supabase)" section in README.md.
# Without these, the site works fully local-only.
#
# Copy this file to `.env.local` and fill in your own project's values.
# Both are safe to expose to the browser (that is what NEXT_PUBLIC_ means):
# the anon/publishable key is protected by the row-level security policies
# in supabase/schema.sql, not by secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
